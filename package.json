{
  "name": "vscode-ftml",
  "publisher": "zokhoi",
  "type": "module",
  "displayName": "FTML/Wikidot Workshop",
  "description": "VSCode extension for support of FTML",
  "version": "0.2.6",
  "engines": {
    "vscode": "^1.75.0"
  },
  "icon": "assets/vscode-ftml.128x128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zokhoi/vscode-ftml.git"
  },
  "bugs": {
    "url": "https://github.com/Zokhoi/vscode-ftml/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.browser.cjs",
  "contributes": {
    "languages": [
      {
        "id": "ftml",
        "aliases": [
          "FTML",
          "ftml",
          "Wikidot code"
        ],
        "extensions": [
          ".ftml",
          ".wd",
          ".wikidot",
          ".wj",
          ".wikijump"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./assets/ftmlang.64x64.png",
          "light": "./assets/ftmlang.64x64.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ftml",
        "scopeName": "text.ftml",
        "path": "./syntaxes/ftml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.katex": "katex",
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "commands": [
      {
        "command": "ftml.preview.open",
        "title": "%ftml.preview.open%",
        "category": "Ftml"
      },
      {
        "command": "ftml.preview.openToSide",
        "title": "%ftml.preview.openToSide%",
        "category": "Ftml",
        "icon": "$(open-preview)"
      },
      {
        "command": "ftml.preview.refresh",
        "title": "%ftml.preview.refresh%",
        "category": "Ftml"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == ftml && !isInDiffEditor",
          "command": "ftml.preview.open",
          "group": "4_ftml"
        },
        {
          "when": "resourceLangId == ftml && !isInDiffEditor",
          "command": "ftml.preview.openToSide",
          "group": "4_ftml"
        }
      ],
      "editor/title": [
        {
          "when": "resourceLangId == ftml && !isInDiffEditor",
          "command": "ftml.preview.open",
          "group": "4_ftml"
        },
        {
          "when": "resourceLangId == ftml && !isInDiffEditor",
          "command": "ftml.preview.openToSide",
          "group": "navigation",
          "icon": "$(preview)"
        }
      ]
    },
    "configuration": [
      {
        "title": "FTML",
        "properties": {
          "ftml.preview.lock": {
            "type": "boolean",
            "default": false,
            "description": "%ftml.preview.lock%"
          },
          "ftml.preview.live": {
            "type": "boolean",
            "default": true,
            "description": "%ftml.preview.live%"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "update:syntax-blocks": "node scripts/updateBlocks.js",
    "compile:worker": "vite build --config ./scripts/config.worker.vite.ts",
    "compile:vite": "vite build --config ./scripts/config.vite.ts",
    "compile:ts": "tsc -p ./",
    "compile:yaml": "pnpx js-yaml ./syntaxes/ftml.tmLanguage.yaml > ./syntaxes/ftml.tmLanguage.json",
    "compile": "pnpm run compile:yaml && pnpm run compile:worker && pnpm run compile:vite",
    "package": "vsce package --no-dependencies",
    "lint": "eslint . --ext .ts,.tsx",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/diff": "^5.0.2",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^22.19.3",
    "@types/vscode": "^1.107.0",
    "@types/vscode-webview": "^1.57.5",
    "esbuild": "^0.14.27",
    "js-yaml": "^4.1.0",
    "toml": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-commonjs-externals": "^0.1.1"
  },
  "dependencies": {
    "@vscode-ftml/ftml-wasm": "^1.28.0",
    "@wikijump/ftml-wasm": "^1.6.3",
    "cross-fetch": "^3.1.5",
    "diff": "^5.0.0",
    "front-matter": "^4.0.2",
    "linkedom": "^0.14.25"
  },
  "packageManager": "pnpm@9.11.0+sha1.4cd20e68438613738e8f2bc9aece61eaa6b3e649"
}
