{
	"name": "vscode-wikidot-preview",
	"publisher": "udotree",
	"displayName": "Wikidot Preview",
	"description": "Wikidot live preview & syntax highlight",
	"version": "0.10.0",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"vscode": "^1.107.0"
	},
	"icon": "assets/vscode-wikidot-preview.128x128.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/smynudop/vscode-ftml"
	},
	"bugs": {
		"url": "https://github.com/smynudop/vscode-ftml/issues"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [],
	"main": "./dist/extension",
	"contributes": {
		"languages": [
			{
				"id": "wikidot",
				"aliases": [
					"wikidot",
					"wd",
					"Wikidot code"
				],
				"extensions": [
					".wikidot",
					".wd"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"dark": "./assets/ftmlang.64x64.png",
					"light": "./assets/ftmlang.64x64.png"
				}
			}
		],
		"grammars": [
			{
				"language": "wikidot",
				"scopeName": "text.wikidot",
				"path": "./syntaxes/wikidot.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.block.css": "css",
					"meta.embedded.block.html": "html",
					"meta.embedded.block.katex": "katex",
					"meta.embedded.block.yaml": "yaml"
				}
			}
		],
		"commands": [
			{
				"command": "wikidot.preview.open",
				"title": "%wikidot.preview.open%",
				"category": "Wikidot"
			},
			{
				"command": "wikidot.preview.openToSide",
				"title": "%wikidot.preview.openToSide%",
				"category": "Wikidot",
				"icon": "$(open-preview)"
			},
			{
				"command": "wikidot.preview.refresh",
				"title": "%wikidot.preview.refresh%",
				"category": "Wikidot"
			}
		],
		"menus": {
			"editor/context": [
				{
					"when": "resourceLangId == wikidot && !isInDiffEditor",
					"command": "wikidot.preview.open",
					"group": "4_wikidot"
				},
				{
					"when": "resourceLangId == wikidot && !isInDiffEditor",
					"command": "wikidot.preview.openToSide",
					"group": "4_wikidot"
				}
			],
			"editor/title": [
				{
					"when": "resourceLangId == wikidot && !isInDiffEditor",
					"command": "wikidot.preview.open",
					"group": "4_wikidot"
				},
				{
					"when": "resourceLangId == wikidot && !isInDiffEditor",
					"command": "wikidot.preview.openToSide",
					"group": "navigation",
					"icon": "$(preview)"
				}
			]
		},
		"configuration": [
			{
				"title": "Wikidot"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run compile",
		"update:syntax-blocks": "node scripts/updateBlocks.js",
		"compile:worker": "vite build --config ./scripts/config.worker.vite.ts",
		"compile:client": "vite build --config ./scripts/config.client.vite.ts",
		"compile:vite": "vite build --config ./scripts/config.vite.ts",
		"compile:ts": "tsc -p ./",
		"compile:yaml": "pnpx js-yaml ./syntaxes/wikidot.tmLanguage.yaml > ./syntaxes/wikidot.tmLanguage.json",
		"compile": "pnpm run compile:yaml && pnpm run compile:worker && pnpm run compile:client && pnpm run compile:vite",
		"package": "vsce package --no-dependencies",
		"lint": "biome lint --fix",
		"lint:summary": "biome lint --reporter=summary",
		"format": "@biomejs/biome format --write",
		"biome:check": "pnpm dlx biome check",
		"watch": "tsc -w -p ./",
		"tsc": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.19.21",
		"@types/vscode": "^1.120.0",
		"@types/vscode-webview": "^1.57.5",
		"js-yaml": "^4.2.0",
		"sass": "^1.101.0",
		"toml": "^3.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@wdprlib/parser": "^3.2.0",
		"@wdprlib/render": "^2.1.0",
		"@wdprlib/runtime": "^1.0.3",
		"front-matter": "^4.0.2"
	},
	"packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
